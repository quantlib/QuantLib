# QuantLib RPM Spec File
%define _aclocaldir %{_datadir}/aclocal
%define docdir %{_prefix}/share/doc/%{name}-%{version}

Name:           QuantLib
Version:        @PACKAGE_VERSION@
Release:        1%{?dist}
Epoch:          0
Summary:        Free and open-source library for quantitative finance

License:        BSD
URL:            https://www.quantlib.org/
Source0:        https://prdownloads.sourceforge.net/quantlib/QuantLib-%{version}.tar.gz
Packager:       Liguo Song (Leo) <liguo.song@vanderbilt.edu>
Vendor:         QuantLib.org
Group:          System Environment/Libraries
BuildRoot:      %{_tmppath}/%{name}-%{version}-%{release}-build

BuildRequires:  autoconf
BuildRequires:  automake
BuildRequires:  libtool
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  boost-devel >= 1.43.0
BuildRequires:  doxygen >= 1.3
BuildRequires:  graphviz

Requires(post): /sbin/ldconfig
Requires(postun): /sbin/ldconfig

%description
QuantLib is a comprehensive open-source C++ library for quantitative finance.
It provides tools for modeling, trading, and risk management in real-life.

%package devel
Summary:        Header files and development libraries for QuantLib
Group:          Development/Libraries
Requires:       %{name} = %{version}, boost >= 1.43.0

%description devel
Install this package if you plan to develop applications that link against the QuantLib C++ libraries.

%package test-suite
Summary:        Test suite for validating QuantLib installation
Group:          Development/Tools
Requires:       %{name} = %{version}, boost-test >= 1.43.0

%description test-suite
This package includes the QuantLib test suite to validate functionality and ensure consistent builds.

%package docs
Summary:        Documentation for QuantLib
Group:          Documentation
Requires:       %{name} = %{version}
Obsoletes:      QuantLib-doc

%description docs
This package provides developer and API documentation for QuantLib. It includes generated HTML files and examples.

%prep
%setup -q

%build
export CFLAGS="%{optflags}"
export CXXFLAGS="%{optflags}"
export FFLAGS="%{optflags}"

%configure --prefix=%{_prefix} EMACS=no
make %{?_smp_mflags}

# Build documentation
pushd Docs
make docs
popd

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot}

# Install documentation
mkdir -p %{buildroot}%{docdir}
cp -p LICENSE.TXT ChangeLog.txt Readme.txt News.txt Contributors.txt %{buildroot}%{docdir}
cp -pr Examples %{buildroot}%{docdir}/
cp -pr Docs/html %{buildroot}%{docdir}/
rm -f %{buildroot}%{docdir}/html/*.dot

%clean
rm -rf %{buildroot}

%post
/sbin/ldconfig

%postun
/sbin/ldconfig

%files
%license LICENSE.TXT
%doc ChangeLog.txt Readme.txt News.txt Contributors.txt
%{_libdir}/libQuantLib.*

%files devel
%doc Examples
%{_includedir}/ql/
%{_libdir}/libQuantLib.a
%{_datadir}/aclocal/*
%{_bindir}/quantlib-config
%{_mandir}/man1/quantlib-config.1.gz

%files test-suite
%{_bindir}/quantlib-test-suite
%{_mandir}/man1/quantlib-test-suite.1.gz

%files docs
%doc %{docdir}/html

%changelog
* Tue Sep 18 2018 Simon John Rees <sjrees@example.com> - 1.13.0-1
- Updated spec file for QuantLib 1.13.0

* Wed Sep 14 2011 Matt Fair <mfair@example.com> - 1.0.0-1
- Updated spec for modern QuantLib builds

* Tue Nov 18 2003 Liguo Song <liguo.song@vanderbilt.edu> - 0.3.4-1
- Initial release of 0.3.4
- Renamed QuantLib-doc to QuantLib-docs

* Fri Aug 22 2003 Liguo Song <liguo.song@vanderbilt.edu> - 0.3.0-1
- Initial package beta release
